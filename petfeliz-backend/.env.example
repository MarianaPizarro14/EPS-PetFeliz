APP_NAME=PetFeliz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-app-backend.up.railway.app

# URLs del frontend separadas por coma para CORS (ej. https://tu-app.vercel.app,https://www.epspetfeliz.site)
FRONTEND_URL=https://tu-app-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.epspetfeliz.site,https://epspetfeliz.site

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=petfeliz
DB_USERNAME=root
DB_PASSWORD=

# Client ID de Google OAuth 2.0 (ej. 123456789-xyz.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="EPS PetFeliz"

# Conexión de cola para correos transaccionales (sync = directo sin queue worker, database = requiere queue:work)
QUEUE_CONNECTION=sync

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_CURRENCY=COP

# Contraseña temporal para seeders de personal de recepción (opcional)
SEED_RECEPCION_PASSWORD=
